# Copy to apps/web/.env (never commit the real file).
NODE_ENV=production
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the site, https in production (secure cookies, trusted origin).
BETTER_AUTH_URL=https://pokemon.example.com
# Ignored in Docker (docker-compose.yml points it at the volume); used for local dev and scripts.
DATABASE_URL=file:../../.data/local.db

{
  "name": "pkmnteambuilder",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "db:push": "vp run --filter @pkmnteambuilder/db db:push",
    "db:studio": "vp run --filter @pkmnteambuilder/db db:studio",
    "db:generate": "vp run --filter @pkmnteambuilder/db db:generate",
    "db:migrate": "vp run --filter @pkmnteambuilder/db db:migrate",
    "db:migrate:run": "vp run --filter @pkmnteambuilder/db db:migrate:run",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && pnpm run auth:generate"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pkmnteambuilder/config": "workspace:*",
    "@types/node": "^26.6.6",
    "rolldown": "1.3.2",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite-plus": "1.6.0"
  },
  "packageManager": "pnpm@12.23.0"
}
